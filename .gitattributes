# Normalize text in Git and specify worktree line endings.
* text=auto
*.py text eol=lf
*.c text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
